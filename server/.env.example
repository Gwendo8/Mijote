# Copier ce fichier en .env et remplir les valeurs (le .env n'est jamais versionné).
NODE_ENV=development
PORT=3000
# Format : postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE
DATABASE_URL=postgres://utilisateur@localhost:5432/mijote
# Adresse du front autorisée à appeler l'API
CORS_ORIGIN=http://localhost:5173
# Adresse publique de l'appli (pour les liens des e-mails)
APP_URL=http://localhost:5173
# E-mails (Brevo). Vides en développement : le lien s'affiche dans le terminal du serveur.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Mijote
# Open Food Facts : présentation de l'appli dans chaque requête (nom, version, contact)
OFF_USER_AGENT=Mijote/1.0 (ton@email.fr)
# Dossier des photos de recettes (relatif à server/)
UPLOAD_DIR=uploads
