# Copier ce fichier en .env.test : variables utilisées par les tests (npm test).
# Les tests utilisent TOUJOURS une base séparée, dont le nom finit par _test, jamais la vraie base.
NODE_ENV=test
PORT=3001
# Format : postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE_test
DATABASE_URL=postgres://utilisateur@localhost:5432/mijote_test
CORS_ORIGIN=http://localhost:5173
